# generated by mkcompat from data/depmap - do not edit

# Debian multiarch triplets we provide filesystem paths for; the arch-specific
# toolchain package provides only the native one
%global debian_multiarch x86_64-linux-gnu aarch64-linux-gnu powerpc64le-linux-gnu riscv64-linux-gnu s390x-linux-gnu

Name:           debian-compat
Version:        20261118
Release:        0
Summary:        Compatibility layer for building and running Debian packages on openSUSE
License:        GPL-2.0-or-later
URL:            https://github.com/bmwiedemann/debiancontrib
Source0:        macros.debian
Source1:        debian-install
Source2:        relocate.map
Source3:        owned-dirs
Source4:        dh_install
Source5:        py3versions
Source6:        dh_bash-completion
Source7:        bash_completion.pm
# no binaries to debug, so the archful toolchain build would only produce an
# empty debugsource package
%global debug_package %{nil}
BuildRequires:  automake
BuildRequires:  binutils
BuildRequires:  docbook-xsl-stylesheets
BuildRequires:  gcc
BuildRequires:  gcc-c++
BuildRequires:  debhelper
BuildRequires:  perl
BuildRequires:  perl-macros
BuildRequires:  pkgconf-pkg-config
BuildRequires:  python-rpm-macros
BuildRequires:  python3-base

%description
Bridges Debian package names, build helpers and filesystem paths to openSUSE
so that Debian source packages can be built with debhelper through shim spec
files. The debian-compat-<name> packages that map individual Debian package
names are built from the debian-compat-mappings source.

%package -n debian-rpm-macros
Summary:        rpm macros to build Debian sources with debhelper
Requires:       autoconf
Requires:       automake
Requires:       debhelper
Requires:       debian-compat-filesystem
Requires:       debian-compat-toolchain
Requires:       dh-autoreconf
Requires:       gettext-tools
Requires:       libtool
Requires:       dpkg
Requires:       patch
Requires:       perl
Requires:       rpm
BuildArch:      noarch

%description -n debian-rpm-macros
%%debian_prep, %%debian_build and %%debian_install run dpkg-source and
debian/rules, then relocate the results into openSUSE paths.

%package filesystem
Summary:        Symlinks from Debian paths to their openSUSE equivalents
Provides:       deb(debian-compat-filesystem)
BuildArch:      noarch

%description filesystem
Symlinks for programs that hard-code Debian multiarch, python or perl paths.

%package -n debian-compat-toolchain
Summary:        Debian triplet-prefixed names for the openSUSE toolchain
Requires:       automake
Requires:       binutils
Requires:       gcc
Requires:       gcc-c++
Requires:       gawk
Requires:       pkgconf-pkg-config

%description -n debian-compat-toolchain
Triplet-prefixed compiler names for the native architecture (x86_64-linux-gnu-gcc
and friends), as Debian build systems expect them.

%package -n debian-compat-sensible-utils
Summary:        Debian compatibility: sensible-utils
Provides:       deb(sensible-utils)
Requires:       dpkg
BuildArch:      noarch

%description -n debian-compat-sensible-utils
sensible-pager and sensible-browser wrappers (sensible-editor comes with dpkg).

%package -n debian-compat-init-system-helpers
Summary:        Debian compatibility: init-system-helpers
Provides:       deb(init-system-helpers)
BuildArch:      noarch

%description -n debian-compat-init-system-helpers
No-op deb-systemd-helper, invoke-rc.d and update-rc.d; openSUSE handles
service enablement with presets.

%prep
%setup -q -c -T

%build

%install
install -Dm644 %{SOURCE0} %{buildroot}%{_rpmmacrodir}/macros.debian
install -Dm755 %{SOURCE1} %{buildroot}/usr/lib/debian-compat/debian-install
install -m644 %{SOURCE2} %{SOURCE3} %{buildroot}/usr/lib/debian-compat/
mkdir -p %{buildroot}/usr/lib/debian-compat/bin
for s in dh_testroot dh_shlibdeps dh_makeshlibs dh_gencontrol dh_md5sums dh_builddeb dh_strip dh_dwz dh_compress dh_installdeb dh_strip_nondeterminism dh_buildinfo dh_perl tcltk-depends; do
    printf '#!/bin/sh\necho "debian-compat: skipping ${0##*/} $*" >&2\n' > %{buildroot}/usr/lib/debian-compat/bin/$s
    chmod 755 %{buildroot}/usr/lib/debian-compat/bin/$s
done
install -m755 %{SOURCE4} %{buildroot}/usr/lib/debian-compat/bin/dh_install
install -m755 %{SOURCE5} %{buildroot}/usr/lib/debian-compat/bin/py3versions
install -m755 %{SOURCE6} %{buildroot}/usr/lib/debian-compat/bin/dh_bash-completion
install -Dm644 %{SOURCE7} %{buildroot}%{perl_vendorlib}/Debian/Debhelper/Sequence/bash_completion.pm
# what Debian's python3-defaults ships for dh-python
mkdir -p %{buildroot}/usr/share/python3
printf '[DEFAULT]\ndefault-version = python%{python3_version}\nsupported-versions = python%{python3_version}\n' > %{buildroot}/usr/share/python3/debian_defaults
# filesystem: Debian multiarch directories for every supported triplet
mkdir -p %{buildroot}/usr/lib/python3 %{buildroot}/usr/share
for mt in %{debian_multiarch}; do ln -s ../lib64 %{buildroot}/usr/lib/$mt; done
ln -s ../$(basename $(dirname %{python3_sitelib}))/site-packages %{buildroot}/usr/lib/python3/dist-packages
ln -s ../lib/perl5/vendor_perl/$(perl -MConfig -e 'print $Config{version}') %{buildroot}/usr/share/perl5
# Debian ships triplet-prefixed toolchain names. The package is arch-specific,
# so only the native triplet is provided; debhelper uses the names matching
# DEB_HOST_GNU_TYPE, which %debian_env derives from the same rpm arch.
mkdir -p %{buildroot}%{_bindir}
case %{_target_cpu} in
    x86_64)  debian_native_triplet=x86_64-linux-gnu ;;
    aarch64) debian_native_triplet=aarch64-linux-gnu ;;
    ppc64le) debian_native_triplet=powerpc64le-linux-gnu ;;
    riscv64) debian_native_triplet=riscv64-linux-gnu ;;
    s390x)   debian_native_triplet=s390x-linux-gnu ;;
    *) echo "debian-compat-toolchain: unsupported arch %{_target_cpu}" >&2; exit 1 ;;
esac
for t in gcc g++ cpp gcc-ar gcc-nm gcc-ranlib ar as ld ld.bfd nm objcopy objdump ranlib readelf strip pkg-config pkgconf; do
    ln -s $t %{buildroot}%{_bindir}/$debian_native_triplet-$t
done
ln -s gawk %{buildroot}%{_bindir}/mawk
# Debian's docbook-xsl location (packages hard-code it in debian/rules)
mkdir -p %{buildroot}/usr/share/sgml/docbook/stylesheet/xsl %{buildroot}/usr/share/xml/docbook/stylesheet
ln -s /usr/share/xml/docbook/stylesheet/nwalsh/current %{buildroot}/usr/share/sgml/docbook/stylesheet/xsl/nwalsh
ln -s nwalsh/current %{buildroot}/usr/share/xml/docbook/stylesheet/docbook-xsl
# Debian's autotools-dev location of config.guess/config.sub (dh_update_autotools_config)
mkdir -p %{buildroot}/usr/share/misc
for f in config.guess config.sub; do install -m755 $(ls -d /usr/share/automake-*/$f | sort -V | tail -1) %{buildroot}/usr/share/misc/$f; done
# dpkg-vendor must answer Debian (DEB_VENDOR is set by %%debian_env)
mkdir -p %{buildroot}%{_sysconfdir}/dpkg/origins
printf 'Vendor: Debian\nVendor-URL: https://www.debian.org/\nBugs: debbugs://bugs.debian.org\n' > %{buildroot}%{_sysconfdir}/dpkg/origins/debian
# Debian's docbook-to-man converts SGML DocBook to a man page on stdout; openSUSE's (docbook2x) reads only XML
cat > %{buildroot}/usr/lib/debian-compat/bin/docbook-to-man <<'SH'
#!/bin/sh
set -e
in=$(readlink -f "$1"); d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT
(cd "$d" && docbook2man "$in" >&2) || echo "docbook-to-man: docbook2man failed on $1, using its output anyway" >&2
out=$(ls "$d" | grep -v '^manpage\.' | head -1)
[ -n "$out" ] && cat "$d/$out"
SH
# Debian's c99 is gcc -std=c99 (openSUSE's posix_cc c99 rejects gcc options)
printf '#!/bin/sh\nexec gcc -std=c99 "$@"\n' > %{buildroot}/usr/lib/debian-compat/bin/c99
chmod 755 %{buildroot}/usr/lib/debian-compat/bin/docbook-to-man %{buildroot}/usr/lib/debian-compat/bin/c99
# sensible-utils
mkdir -p %{buildroot}%{_bindir}
cat > %{buildroot}%{_bindir}/sensible-pager <<'SH'
#!/bin/sh
exec ${PAGER:-less} "$@"
SH
cat > %{buildroot}%{_bindir}/sensible-browser <<'SH'
#!/bin/sh
exec ${BROWSER:-xdg-open} "$@"
SH
# init-system-helpers
for s in deb-systemd-helper deb-systemd-invoke invoke-rc.d update-rc.d; do
    printf '#!/bin/sh\nexit 0\n' > %{buildroot}%{_bindir}/$s
done
chmod 755 %{buildroot}%{_bindir}/sensible-* %{buildroot}%{_bindir}/deb-systemd-* %{buildroot}%{_bindir}/invoke-rc.d %{buildroot}%{_bindir}/update-rc.d

%files -n debian-rpm-macros
%{_rpmmacrodir}/macros.debian
/usr/lib/debian-compat
%dir %{_sysconfdir}/dpkg
%dir %{_sysconfdir}/dpkg/origins
%config %{_sysconfdir}/dpkg/origins/debian
%dir /usr/share/python3
/usr/share/python3/debian_defaults
%{perl_vendorlib}/Debian/Debhelper/Sequence/bash_completion.pm

%files filesystem
/usr/lib/*-linux-gnu
%dir /usr/lib/python3
/usr/lib/python3/dist-packages
/usr/share/perl5
%dir /usr/share/sgml/docbook/stylesheet
/usr/share/sgml/docbook/stylesheet/xsl
/usr/share/xml/docbook/stylesheet/docbook-xsl

%files -n debian-compat-toolchain
%{_bindir}/*-linux-gnu-*
%{_bindir}/mawk
/usr/share/misc/config.guess
/usr/share/misc/config.sub

%files -n debian-compat-sensible-utils
