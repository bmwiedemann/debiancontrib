#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# debian-compat wrapper: debian/*.install files hard-code Debian's perl and python paths,
# so move what openSUSE's interpreters installed into debian/tmp to those paths
# (debian-install relocates them back when building the rpm)
move() { # move SRC DST: merge directory SRC into DST and remove SRC
    [ -d "$1" ] || return 0
    mkdir -p "$2" && (cd "$1" && tar cf - .) | (cd "$2" && tar xf -) && rm -rf "$1"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$1")" 2>/dev/null; return 0
}
d=debian/tmp
if [ -d $d ]; then
    v=$(perl -MConfig -e 'print $Config{version}')
    vmaj=${v%.*}
    move $d/usr/lib/perl5/vendor_perl/$v/x86_64-linux-thread-multi $d/usr/lib/x86_64-linux-gnu/perl5/$vmaj
    move $d/usr/lib/perl5/vendor_perl/$v $d/usr/share/perl5
    for site in $(python3 -c 'import sysconfig; print(sysconfig.get_path("purelib"), sysconfig.get_path("platlib"))'); do
        move $d$site $d/usr/lib/python3/dist-packages
    done
fi
exec /usr/bin/dh_install "$@"
