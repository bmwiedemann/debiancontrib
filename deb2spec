#!/usr/bin/perl
# SPDX-License-Identifier: GPL-2.0-or-later
# usage: deb2spec SRCNAME EXTRACTED_SRC_DIR > SRCNAME.spec
# generates the shim spec for a Debian source package; knobs come from overrides/SRCNAME.conf
use strict; use warnings;
use FindBin; use lib "$FindBin::RealBin/lib";
use deb qw(read_control dep_names debver2rpm supported_arches debian_arch arch_matches);
use tsv;
use POSIX qw(strftime);

my ($src, $dir) = @ARGV;
die "usage: $0 SRCNAME EXTRACTED_SRC_DIR\n" unless $src && -d "$dir/debian";
my $top = $FindBin::RealBin;
my $cache = $ENV{cache} // "$top/cache";

my %o;
tsv::read_tsv("$top/overrides/$src.conf", sub { $o{$_[0]} = $_[1] }) if -e "$top/overrides/$src.conf";
my %ignore; tsv::read_tsv("$top/data/depmap.ignore", sub { $ignore{$_[0]} = 1 });
# build dependencies are resolved to the openSUSE requires themselves, so that
# regenerating debian-compat-mappings does not rebuild every consumer
my %map;
tsv::read_tsv("$top/data/depmap", sub { $map{$_[0]} = [split /,/, $_[1]] }) if -e "$top/data/depmap";
tsv::read_tsv("$top/data/depmap.manual", sub { $map{$_[0]} = [split /,/, $_[1]] }) if -e "$top/data/depmap.manual";
my %ourprov; # deb() names provided by packages of this project (except the generated mappings)
open(my $tprov, '<', "$top/debian-compat/debian-compat.spec.in") or die;
while (<$tprov>) { $ourprov{$1} = 1 if /^Provides:\s*deb\(([^)]+)\)/ }
close $tprov;
for my $spec (glob("$top/obs/*/*.spec")) {
    next if $spec =~ m{/debian-compat/} || $spec =~ m{/debian-compat-mappings/};
    open(my $fh, '<', $spec) or next;
    while (<$fh>) { $ourprov{$1} = 1 if /^Provides:\s*deb\(([^)]+)\)/ }
    close $fh;
}
my %lic; tsv::read_tsv("$top/data/licensemap", sub { $lic{$_[0]} = $_[1] });
my @drop = split /,/, $o{drop_buildrequires} // '';
my @dropreq = split /,/, $o{drop_requires} // '';
my %prefer = map { $_ => 1 } split /,/, $o{prefer_alt} // '';
my %skip = map { $_ => 1 } split /,/, $o{skip_binaries} // '';
my $nocheck = $o{nocheck} // 1;

my ($entry) = grep { $_->[0] eq $src } @{tsv::read_tsv("$cache/debian-sources.tsv")} or die "$src not in debian-sources.tsv\n";
my ($name, $debver, $comp, $sec, $prio, $pooldir, $files, $bins, $home) = @$entry;
my ($epoch, $version, $rev) = debver2rpm($debver);
(my $noepoch = $debver) =~ s/^\d+://;
my @sources = map { (split /:/)[0] } split /;/, $files;
@sources = ((grep { /\.dsc$/ } @sources), (grep { !/\.dsc$/ } @sources));

my $ctrl = read_control("$dir/debian/control");
my $srcctrl = $ctrl->get_source();
my @pkgs = grep { !$skip{$_->{Package}} && ($_->{'Package-Type'} // 'deb') eq 'deb' && ($_->{Section} // '') ne 'debug' && $_->{Package} !~ /-dbg(sym)?$/ } $ctrl->get_packages();
die "no binary packages\n" unless @pkgs;
my %sibling = map { $_->{Package} => 1 } @pkgs;
my $noarch = !grep { $_->{Architecture} ne 'all' } @pkgs; # the whole spec is BuildArch: noarch
# arches on which every non-all binary package's Debian Architecture permits a build
my @all_arches = supported_arches();
my @buildable = grep {
    my $deb = debian_arch($_);
    !grep { $_->{Architecture} ne 'all' && !arch_matches($deb, $_->{Architecture}) } @pkgs
} @all_arches;

sub dep_choices($$) { # field value, build flag -> ([rpm dep strings in field order], {dep => {rpm arch => 1}})
    my ($v, $build) = @_;
    my @d = $build ? @drop : @dropreq;
    my (@order, %out);
    for my $rpm (supported_arches()) {
        my @n = grep { my $x = $_; !$ignore{$x} && !grep { $_ eq $x } @d }
            dep_names($v, build => $build, nocheck => $nocheck, prefer => \%prefer,
                      host_arch => debian_arch($rpm));
        for my $x (@n) {
            my @r;
            if ($sibling{$x}) { @r = ("deb($x) = %{version}") }  # same source package
            elsif ($ourprov{$x}) { @r = ("deb($x)") }             # another package of this project
            elsif ($build && $map{$x}) { @r = @{$map{$x}} }       # mapped openSUSE build requires
            else { @r = ("deb($x)") }
            for (@r) {
                push @order, $_ unless exists $out{$_};
                $out{$_}{$rpm} = 1;
            }
        }
    }
    return (\@order, \%out);
}

# dep_spec_lines($prefix, $field, $build, $filter, $sort, @extra) -> spec lines,
# wrapped in an arch condition when Debian's restriction applies to only some
# arches. %ifarch is inert in a BuildArch: noarch spec, so use the worker's
# %{_host_cpu} there. @extra are further dependency strings for the same field.
sub dep_spec_lines {
    my ($prefix, $v, $build, $filter, $sort, @extra) = @_;
    my ($order, $choices) = dep_choices($v, $build);
    my @all = supported_arches();
    my (@plain, @cond);
    for my $dep (@$order) {
        next if $filter && !$filter->($dep);
        my @a = grep { $choices->{$dep}{$_} } @all;
        next unless @a;
        my $if = $noarch ? '%if ' . join(' || ', map { qq{"%{_host_cpu}" == "$_"} } @a)
                         : '%ifarch ' . join(' ', @a);
        if (@a == @all) { push @plain, $dep }
        else { push @cond, $if, $dep, '%endif' }
    }
    return (map { "$prefix$_" } $sort ? sort(@extra, @plain) : (@extra, @plain)),
           (map { /^%/ ? $_ : "$prefix$_" } @cond);
}
sub license() {
    my $c = "$dir/debian/copyright";
    return 'UNKNOWN' unless -e $c;
    open(my $fh, '<', $c) or die; local $/; my $t = <$fh>; close $fh;
    my %l;
    if ($t =~ /^Format:.*copyright-format/mi) {
        for my $expr ($t =~ /^License:\s*(.+)$/mg) {
            for my $tok (split /\s+(?:and|or|,)\s+|\s*,\s*/, $expr) {
                $tok =~ s/^\s+|\s+$//g; $tok =~ s/\s+with\s+.*//i;
                next unless length $tok;
                $l{$lic{$tok} // $tok} = 1;
            }
        }
    } else {
        $l{'GPL-3.0-or-later'} = 1 if $t =~ /GNU General Public License.*version 3/si;
        $l{'GPL-2.0-or-later'} = 1 if $t =~ /GNU General Public License.*version 2/si && !%l;
        $l{'LGPL-2.1-or-later'} = 1 if $t =~ /Lesser General Public/si;
        $l{MIT} = 1 if $t =~ /MIT License|Permission is hereby granted, free of charge/si;
        $l{'BSD-3-Clause'} = 1 if $t =~ /Redistribution and use in source and binary forms/si;
    }
    return %l ? join(' AND ', sort keys %l) : 'UNKNOWN';
}
sub desc($) { my $d = shift // ''; $d =~ s/^[^\n]*\n//; $d =~ s/^ //mg; $d =~ s/^\.$//mg; $d =~ s/\s+$//; return $d }
sub summary($) { my $s = (shift // '') =~ s/\n.*//sr; $s =~ s/\.$//; return $s || $src }

my $main = (grep { $_->{Package} eq $src } @pkgs)[0] // (grep { $_->{Package} !~ /-(dev|doc|data|common)$/ } @pkgs)[0] // $pkgs[0];
my @br = dep_spec_lines('BuildRequires:  ', join(', ', grep { defined } map { $srcctrl->{$_} } qw(Build-Depends Build-Depends-Indep Build-Depends-Arch)), 1, undef, 1,
    grep { !/^\s*$/ } ('debian-rpm-macros', split /,/, $o{extra_buildrequires} // ''));
my @patches = sort map { s{.*/}{}r } glob("$top/overrides/$src/*.patch");

my @out;
push @out, "#", "# spec file for package $src", "#", "# Copyright (c) " . strftime('%Y', gmtime) . " SUSE LLC and contributors", "#",
    "# All modifications and additions to the file contributed by third parties", "# remain the property of their copyright owners, unless otherwise agreed",
    "# upon. The license for this file, and modifications and additions to the", "# file, is the same license as for the pristine package itself (unless the",
    "# license for the pristine package is not an Open Source License, in which", "# case the license is the MIT License). An \"Open Source License\" is a",
    "# license that conforms to the Open Source Definition (Version 1.9)", "# published by the Open Source Initiative.", "", "# Please submit bugfixes or comments via https://bugs.opensuse.org/", "#", "";
push @out, "# generated by deb2spec from Debian source $src $debver - do not edit, regenerate", "";
push @out, "# needsrootforbuild" if $o{needsroot};
push @out, "%global debian_source $src", "%global debian_version $debver";
push @out, "%global debian_nocheck 1" if $nocheck;
push @out, "%global debian_build_options $o{build_options}" if $o{build_options};
push @out, "%global debian_nolto 1" if $o{nolto};
push @out, "%global debian_patches @patches" if @patches;
push @out, "Name:           $src", "Version:        $version", "Release:        0";
push @out, "Epoch:          $epoch" if $epoch;
push @out, "Summary:        " . summary($main->{Description}), "License:        " . license();
push @out, "URL:            $home" if length $home;
my $i = 0;
push @out, sprintf("Source%d:        %s/%s/%s", $i++, $ENV{mirror} // 'http://ftp.gwdg.de/pub/linux/debian/debian', $pooldir, $_) for @sources;
$i = 0; push @out, sprintf("Patch%d:         %s", $i++, $_) for @patches;
push @out, grep { /\S/ } @br;
push @out, "BuildArch:      noarch" if $noarch;
push @out, "ExclusiveArch:  " . join(' ', @buildable ? @buildable : ('none'))
    if !$noarch && @buildable < @all_arches;
(my $provver = $debver) =~ s/-(?=.*-)/_/g; # rpm versions allow one dash only
push @out, "Provides:       deb(src:$src) = $provver" if ($o{"rename_$main->{Package}"} // $main->{Package}) eq $src;
push @out, "", "%description", desc($main->{Description}), "";
my $mainpos = $#out - 2; # the main package's dependencies go before its %description
for my $p (@pkgs) {
    my $n = $p->{Package};
    my $rn = $o{"rename_$n"} // $n; # RPM name, when the Debian name is taken by an openSUSE package
    my $ismain = $rn eq $src;
    push @out, "%package -n $rn", "Summary:        " . summary($p->{Description}) unless $ismain;
    my @l;
    push @l, "BuildArch:      noarch" if $p->{Architecture} eq 'all' && !$ismain && grep { $_->{Architecture} ne 'all' } @pkgs;
    push @l, "Provides:       deb($n) = %{version}";
    push @l, "Provides:       deb(src:$src) = $provver" if $n eq $main->{Package} && !$ismain;
    push @l, map { "Provides:       deb($_)" } dep_names($p->{Provides});
    push @l, dep_spec_lines('Requires:       ', join(', ', grep { defined } $p->{'Pre-Depends'}, $p->{Depends}), 0);
    push @l, map { "Requires:       $_" } split /,/, $o{"extra_requires_$n"} // '';
    push @l, map { "Conflicts:      $_" } split /,/, $o{"extra_conflicts_$n"} // '';
    push @l, dep_spec_lines('Recommends:     ', $p->{Recommends}, 0);
    push @l, dep_spec_lines('Suggests:       ', $p->{Suggests}, 0);
    push @l, dep_spec_lines('Conflicts:      ', join(', ', grep { defined } $p->{Conflicts}, $p->{Breaks}), 0,
        sub { my $x = shift; grep { "deb($_->{Package})" eq $x } @pkgs });
    if ($ismain) { splice @out, $mainpos, 0, @l } else { push @out, @l, "", "%description -n $rn", desc($p->{Description}), "" }
}
push @out, "%prep", "%debian_prep", "", "%build", "%debian_build", "", "%install", "%debian_install", "";
push @out, "%check", "%debian_check", "" unless $nocheck;
for my $p (@pkgs) {
    my $n = $p->{Package};
    my $rn = $o{"rename_$n"} // $n;
    push @out, ($rn eq $src ? "%files" : "%files -n $rn") . " -f %{_builddir}/%{buildsubdir}/rpmfiles/$n", "";
}
push @out, "%changelog";
print join("\n", @out), "\n";
