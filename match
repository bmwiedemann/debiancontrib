#!/usr/bin/perl
# SPDX-License-Identifier: GPL-2.0-or-later
# usage: match  - decide for every Debian source whether openSUSE already has an equivalent
# writes cache/match.tsv (source, status, evidence) and out/match-audit.tsv for the weaker matches
use strict; use warnings;
use FindBin; use lib "$FindBin::RealBin/lib";
use deb qw(normalize_name norm_url file_key dep_names);
use tsv;

my $cache = $ENV{cache} // "$FindBin::RealBin/cache";
my $out = $ENV{out} // "$FindBin::RealBin/out";

my (%src, %url, %bin, %file);
tsv::read_tsv("$cache/suse-sources.tsv", sub { push @{$src{lc $_[0]}}, $_[3]; push @{$url{norm_url($_[2])}}, $_[0] if $_[2] =~ m{^https?://[^/]+/.} });
tsv::read_tsv("$cache/suse-provides.tsv", sub { $bin{lc $_[0]} //= $_[1] if $_[0] !~ m{^/|\(} });
tsv::read_tsv("$cache/suse-binaries.tsv", sub { $bin{lc $_[0]} //= $_[0] });
tsv::read_tsv("$cache/suse-files.tsv", sub { my $k = file_key($_[0]); $file{$k} //= $_[1] if $k && $_[1] !~ /-32bit$/ });
# font family = file name up to the style; openSUSE's may add a short region suffix: Debian's NotoSansCJK-Bold.ttc
# is openSUSE's NotoSansCJKjp-VF.otf, but AtkinsonHyperlegible is not AtkinsonHyperlegibleNext
sub fontfam($) { $_[0] =~ /^font:([a-z0-9]+)/ ? $1 : '' }
my %fam;
for my $k (sort grep { /^font:/ } keys %file) { my $f = fontfam($k); $fam{substr($f, 0, $_)} //= $file{$k} for grep { $_ >= 8 } length($f) - 3 .. length $f }
my %depmap; # Debian binary -> openSUSE package, from mkdepmap's per-binary heuristics (perl/python modules, sonames, .pc files ...)
tsv::read_tsv("$FindBin::RealBin/data/depmap", sub { $depmap{$_[0]} = $_[1] });
my %debfiles; # binary -> {file_key}
tsv::read_tsv("$cache/debian-files.tsv", sub { my $k = file_key($_[0]); $debfiles{$_[1]}{$k} = 1 if $k });
my %nfiles; # binary -> files outside /usr/share/{doc,lintian,bug}; metapackages and transitional packages have none
tsv::read_tsv("$cache/debian-nfiles.tsv", sub { $nfiles{$_[0]} = $_[1] });
my (%binsrc, %bindeps);
my %binsec;
tsv::read_tsv("$cache/debian-binaries.tsv", sub { $binsrc{$_[0]} //= $_[1]; $bindeps{$_[0]} //= "$_[6], $_[7]"; $binsec{$_[0]} //= $_[4] });
# AppStream component IDs (org.kde.spectacle, CorsixTH ...) are chosen upstream and shared by both distributions
sub asid($) { lc($_[0]) =~ s/\.desktop$//r }
my (%suseas, %debas); # ID -> openSUSE package; Debian source -> [IDs]
tsv::read_tsv("$cache/suse-appstream.tsv", sub { $suseas{asid($_[0])} //= $_[1] }) if -e "$cache/suse-appstream.tsv";
tsv::read_tsv("$cache/debian-appstream.tsv", sub { push @{$debas{$binsrc{$_[1]}}}, asid($_[0]) if $binsrc{$_[1]} }) if -e "$cache/debian-appstream.tsv";

sub insrc($) { my @c = normalize_name($_[0]); for (@c) { return ($_, @{$src{$_}}) if $src{$_} } return }

my %have = map { chomp; split /\t/ } grep { !/^#/ && /\S/ } do { open(my $h, '<', "$FindBin::RealBin/exceptions/have") or die; <$h> };
my (@res, @audit, %count);
tsv::read_tsv("$cache/debian-sources.tsv", sub {
    my ($name, $ver, $comp, $sec, $prio, $dir, $files, $bins, $home) = @_;
    my ($status, $ev);
    if ($have{$name} && $have{$name} eq '-') { ($status, $ev) = ('missing', 'distinct (exceptions/have)') }
    elsif ($have{$name}) { ($status, $ev) = ('have-manual', $have{$name}) }
    elsif ($src{lc $name}) { ($status, $ev) = ('have-name', join(' ', @{$src{lc $name}})) }
    elsif (my ($n, @o) = insrc($name)) { ($status, $ev) = ('have-norm', "$n @o") }
    elsif (length $home && $url{norm_url($home)}) { ($status, $ev) = ('have-url', "$home = @{$url{norm_url($home)}}[0]") }
    elsif (my @as = grep { $suseas{$_} } @{$debas{$name} // []}) { ($status, $ev) = ('have-appstream', join(',', map { "$_=$suseas{$_}" } @as)) }
    else {
        my ($orig) = $files =~ /(?:^|;)([^;:]+?)_[^;:]*\.orig\.tar[^;:]*:/;
        if ($orig && (my ($n2, @o2) = insrc($orig))) { ($status, $ev) = ('have-tarball', "$orig -> $n2 @o2") }
        else {
            my @b = grep { !/-(doc|dbg|dbgsym|whl|udeb|dev|common|data|examples|bin|tools|utils)$/ } split /,/, $bins;
            @b = grep { !/-(doc|dbg|dbgsym|whl|udeb)$/ } split /,/, $bins unless @b;
            my @hit = grep { my $b = $_; $depmap{$b} || grep { $bin{$_} } normalize_name($b) } @b;
            my %bf = map { %{$debfiles{$_} // {}} } grep { !/-(doc|dbg|dbgsym|udeb)$/ } split /,/, $bins;
            my @bf = sort keys %bf;
            my (%ftot, %fok, %fsrc); # per key class (bin, font, so, inc ...), so -dev headers laid out differently do not outvote matching commands
            for (@bf) {
                my ($c) = /^(\w+):/; $ftot{$c}++;
                my $p = $file{$_} // ($c eq 'font' ? $fam{fontfam($_)} : undef) or next;
                $fsrc{$_} = $p; push @{$fok{$c}}, $_;
            }
            # one command name or header (memdump, notify, db.h) is too common to decide on, unless it is the package's
            # own name (ecj, tkdiff); one font/module/soname is not
            my %own = map { $_ => 1 } $name, split /,/, $bins;
            my %okc = map { $_ => 1 } grep { $fok{$_} && @{$fok{$_}} * 2 >= $ftot{$_} && (@{$fok{$_}} >= 2 || !/^(bin|inc|pc)$/ || $own{$fok{$_}[0] =~ s/^bin://r}) } keys %ftot;
            # headers alone do not decide when none of the commands exist (minimap2 bundles klib's headers)
            %okc = () if $ftot{bin} && !$fok{bin} && !grep { !/^(inc|pc)$/ } keys %okc;
            my @fhit = map { @{$fok{$_}} } sort keys %okc;
            @bf = grep { my ($c) = /^(\w+):/; $okc{$c} } @bf;
            my %fpkg; $fpkg{$fsrc{$_}}++ for @fhit;
            if (@hit && (@hit * 2 >= @b || grep { $_ eq $name } @hit)) { ($status, $ev) = ('have-binary', join(',', map { $depmap{$_} ? "$_=$depmap{$_}" : $_ } @hit) . " of " . scalar(@b)) }
            elsif (@fhit) {
                my @p = sort { $fpkg{$b} <=> $fpkg{$a} || $a cmp $b } keys %fpkg; splice @p, 3;
                ($status, $ev) = ('have-files', join(',', @p) . " " . scalar(@fhit) . "/" . scalar(@bf) . " e.g. $fhit[0]");
            }
            elsif (@hit) { ($status, $ev) = ('missing', "weak: binaries @hit of " . scalar(@b)) }
            else { ($status, $ev) = ('missing', '') }
        }
    }
    push @res, [$name, $status, $ev, $bins];
});
# metapackages / transitional packages (no files beyond /usr/share/{doc,lintian,bug}, not documentation)
# whose dependencies openSUSE already has; repeated until metapackages of metapackages settle
my %st = map { $_->[0] => $_->[1] } @res;
for (my $changed = 1; $changed;) {
    $changed = 0;
    for my $r (grep { $_->[1] eq 'missing' && !$have{$_->[0]} } @res) {
        my @b = grep { !/-(doc|dbg|dbgsym|udeb)$/ } split /,/, $r->[3];
        next if !@b || grep { $nfiles{$_} || !exists $bindeps{$_} } @b; # not built on amd64 counts as unknown
        next unless grep { ($binsec{$_} // '') !~ m{(^|/)doc$} } @b;
        my %own = map { $_ => 1 } @b;
        my %seen; my @d = grep { !$own{$_} && !$seen{$_}++ } map { dep_names($bindeps{$_} // '') } @b;
        my @ok = grep { my $d = $_; ($binsrc{$d} && ($st{$binsrc{$d}} // '') =~ /^have-/) || $depmap{$d} || grep { $bin{$_} } normalize_name($d) } @d;
        next unless @d && @ok * 2 >= @d;
        @$r[1, 2] = ('have-meta', scalar(@ok) . "/" . scalar(@d) . " deps: " . join(',', @ok[0..($#ok > 4 ? 4 : $#ok)]));
        $st{$r->[0]} = 'have-meta'; $changed = 1;
    }
}
for (@res) {
    pop @$_;
    $count{$_->[1]}++;
    push @audit, $_ if $_->[1] =~ /^have-(url|appstream|binary|files|meta)$/ || $_->[2] =~ /^weak/;
}
# our own packages that now look like duplicates of something openSUSE has
my %ours;
tsv::read_tsv("$cache/project-provides.tsv", sub { $ours{$1} = 1 if $_[0] =~ /^src:(.+)/ }) if -e "$cache/project-provides.tsv";
print STDERR "possible duplicate in project: $_->[0] $_->[1] $_->[2]\n" for grep { $ours{$_->[0]} && $_->[1] ne 'missing' } @res;
tsv::write_tsv("$cache/match.tsv", \@res);
tsv::write_tsv("$out/match-audit.tsv", \@audit);
print map { sprintf "%-12s %d\n", $_, $count{$_} } sort keys %count;
