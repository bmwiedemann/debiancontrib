#!/usr/bin/perl
# SPDX-License-Identifier: GPL-2.0-or-later
# usage: match  - decide for every Debian source whether openSUSE already has an equivalent
# writes cache/match.tsv (source, status, evidence) and out/match-audit.tsv for the weaker matches
use strict; use warnings;
use FindBin; use lib "$FindBin::RealBin/lib";
use deb qw(normalize_name norm_url);
use tsv;

my $cache = $ENV{cache} // "$FindBin::RealBin/cache";
my $out = $ENV{out} // "$FindBin::RealBin/out";

my (%src, %url, %bin, %file);
tsv::read_tsv("$cache/suse-sources.tsv", sub { push @{$src{lc $_[0]}}, $_[3]; push @{$url{norm_url($_[2])}}, $_[0] if $_[2] =~ m{^https?://[^/]+/.} });
tsv::read_tsv("$cache/suse-provides.tsv", sub { $bin{lc $_[0]} //= $_[1] if $_[0] !~ m{^/|\(} });
tsv::read_tsv("$cache/suse-binaries.tsv", sub { $bin{lc $_[0]} //= $_[0] });
tsv::read_tsv("$cache/suse-files.tsv", sub { $file{$_[0]} = $_[1] if $_[0] =~ m{^/usr/s?bin/} });
my %depmap; # Debian binary -> openSUSE package, from mkdepmap's per-binary heuristics (perl/python modules, sonames, .pc files ...)
tsv::read_tsv("$FindBin::RealBin/data/depmap", sub { $depmap{$_[0]} = $_[1] });
my %debfiles; # binary -> [/usr/bin paths]
tsv::read_tsv("$cache/debian-files.tsv", sub { push @{$debfiles{$_[1]}}, $_[0] if $_[0] =~ m{^/usr/s?bin/} });

sub insrc($) { my @c = normalize_name($_[0]); for (@c) { return ($_, @{$src{$_}}) if $src{$_} } return }

my %have = map { chomp; split /\t/ } grep { !/^#/ && /\S/ } do { open(my $h, '<', "$FindBin::RealBin/exceptions/have") or die; <$h> };
my (@res, @audit, %count);
tsv::read_tsv("$cache/debian-sources.tsv", sub {
    my ($name, $ver, $comp, $sec, $prio, $dir, $files, $bins, $home) = @_;
    my ($status, $ev);
    if ($have{$name}) { ($status, $ev) = ('have-manual', $have{$name}) }
    elsif ($src{lc $name}) { ($status, $ev) = ('have-name', join(' ', @{$src{lc $name}})) }
    elsif (my ($n, @o) = insrc($name)) { ($status, $ev) = ('have-norm', "$n @o") }
    elsif (length $home && $url{norm_url($home)}) { ($status, $ev) = ('have-url', "$home = @{$url{norm_url($home)}}[0]") }
    else {
        my ($orig) = $files =~ /(?:^|;)([^;:]+?)_[^;:]*\.orig\.tar[^;:]*:/;
        if ($orig && (my ($n2, @o2) = insrc($orig))) { ($status, $ev) = ('have-tarball', "$orig -> $n2 @o2") }
        else {
            my @b = grep { !/-(doc|dbg|dbgsym|whl|udeb|dev|common|data|examples|bin|tools|utils)$/ } split /,/, $bins;
            @b = grep { !/-(doc|dbg|dbgsym|whl|udeb)$/ } split /,/, $bins unless @b;
            my @hit = grep { my $b = $_; $depmap{$b} || grep { $bin{$_} } normalize_name($b) } @b;
            my @bf = map { @{$debfiles{$_} // []} } @b;
            my @fhit = grep { $file{$_} } @bf;
            if (@hit && (@hit * 2 >= @b || grep { $_ eq $name } @hit)) { ($status, $ev) = ('have-binary', join(',', map { $depmap{$_} ? "$_=$depmap{$_}" : $_ } @hit) . " of " . scalar(@b)) }
            elsif (@fhit && @fhit * 2 >= @bf) { ($status, $ev) = ('have-files', join(',', @fhit[0..($#fhit > 2 ? 2 : $#fhit)]) . " " . scalar(@fhit) . "/" . scalar(@bf)) }
            elsif (@hit) { ($status, $ev) = ('missing', "weak: binaries @hit of " . scalar(@b)) }
            else { ($status, $ev) = ('missing', '') }
        }
    }
    $count{$status}++;
    push @res, [$name, $status, $ev];
    push @audit, [$name, $status, $ev] if $status =~ /^have-(url|binary|files)$/ || $ev =~ /^weak/;
});
tsv::write_tsv("$cache/match.tsv", \@res);
tsv::write_tsv("$out/match-audit.tsv", \@audit);
print map { sprintf "%-12s %d\n", $_, $count{$_} } sort keys %count;
