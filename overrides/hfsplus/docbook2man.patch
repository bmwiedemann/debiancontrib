Description: openSUSE's docbook-to-man (docbook2x) reads only XML; docbook-utils' docbook2man
 converts the SGML sources and names the output after the refentry (hpcd.1 ...)

--- a/debian/rules
+++ b/debian/rules
@@ -12,5 +12,5 @@
 		for man in hfsplus.7 hpcd.1 hpcopy.1 hpfsck.1 \
 			hpls.1 hpmkdir.1 hpmount.1 hppwd.1 \
 			hprm.1 hpumount.1; \
-		do docbook-to-man `echo $$man|sed 's/[17]/sgml/'` >$$man; \
+		do docbook2man `echo $$man|sed 's/[17]/sgml/'` >/dev/null; \
 	done)
